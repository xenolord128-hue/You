# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Public Maps JavaScript API key (restricted by HTTP referrer in GCP).
VITE_GOOGLE_MAPS_API_KEY=""

# Server-side Admin Panel password & session signing secret (never exposed to browser)
ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"
ADMIN_SESSION_SECRET="CHANGE_ME_RANDOM_HEX_SECRET"

# Optional: External Node backend URL when hosting static frontend on Netlify/cPanel
VITE_API_BASE_URL=""

# Optional: Comma-separated allowed frontend origins for cross-origin admin sessions
ALLOWED_ORIGINS="https://pythoxworld.com,https://www.pythoxworld.com,https://pythoxworld.netlify.app"

# Server-side SR Host BD cPanel MySQL configuration (NEVER expose to browser or prefix with VITE_)
DB_HOST="localhost"
DB_NAME="pythoxwo_Rld"
DB_USER="pythoxwo_Pythox"
DB_PASSWORD=""
DB_PORT="3306"

# Optional: Server-side Admin Order Notification channels (NEVER prefix private keys with VITE_)
ADMIN_NOTIFICATION_EMAIL=""
EMAILJS_PRIVATE_KEY=""
RESEND_API_KEY=""
ADMIN_ORDER_WEBHOOK_URL=""

# Optional: EmailJS public client identifiers (non-secret; defaults are built in)
VITE_EMAILJS_SERVICE_ID="service_jlw1nj9"
VITE_EMAILJS_TEMPLATE_ID="template_ytbv3oj"
VITE_EMAILJS_PUBLIC_KEY="mq7QXXen_i72fccjy"
