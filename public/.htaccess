<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preserve cPanel AutoSSL / Let's Encrypt verification and CGI directories
  RewriteCond %{REQUEST_URI} ^/(\.well-known|cgi-bin)(/|$) [NC]
  RewriteRule ^ - [L]

  # Do not rewrite API or uploaded media endpoints to index.html
  RewriteCond %{REQUEST_URI} ^/(api|uploads)(/|$) [NC]
  RewriteRule ^ - [L]

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all client-side React Router paths to the SPA entry point
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
</IfModule>

<IfModule mod_headers.c>
  # Prevent stale cached HTML referencing old hashed asset bundles
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Long-term caching for Vite content-hashed assets
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

DirectoryIndex index.html
