# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Public Maps JavaScript API key (restricted by HTTP referrer in GCP).
VITE_GOOGLE_MAPS_API_KEY=""

# Server-side Admin Panel password & session signing secret (never exposed to browser)
ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"
ADMIN_SESSION_SECRET="CHANGE_ME_RANDOM_HEX_SECRET"
